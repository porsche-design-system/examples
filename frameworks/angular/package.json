{
  "name": "@porsche-design-system/angular",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prebuild": "node prebuild.mjs",
    "start": "npm run prebuild && ng serve",
    "build": "npm run prebuild && ng build --base-href \"$ANGULAR_PUBLIC_BASE_PATH\"",
    "watch": "npm run prebuild && ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test --config=tests/e2e/config/playwright.config.ts"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "^21.2.9",
    "@angular/compiler": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@angular/platform-browser": "^21.2.9",
    "@angular/router": "^21.2.9",
    "@porsche-design-system/components-angular": "4.0.0-rc.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.9",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/jasmine": "~6.0.0",
    "jasmine-core": "~6.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.3"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
