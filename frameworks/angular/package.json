{
  "name": "@porsche-design-system/angular",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ci": "npm run build -- --base-href /examples/angular/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test --config=tests/e2e/config/playwright.config.ts"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "^20.3.11",
    "@angular/compiler": "^20.3.3",
    "@angular/core": "^20.3.3",
    "@angular/forms": "^20.3.11",
    "@angular/platform-browser": "^20.3.3",
    "@angular/router": "^20.3.11",
    "@porsche-design-system/components-angular": "^3.30.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@angular-builders/custom-webpack": "^20.0.0",
    "@angular/build": "^20.3.10",
    "@angular/cli": "^20.3.10",
    "@angular/compiler-cli": "^20.3.11",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/jasmine": "~5.1.12",
    "jasmine-core": "~5.12.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
