{
  "name": "@porsche-design-system/examples",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": {
    "packages": [
      "frameworks/next-js",
      "frameworks/react-router",
      "patterns",
      "templates"
    ]
  },
  "scripts": {
    "dev:next-js": "yarn --cwd frameworks/next-js dev",
    "dev:react-router": "yarn --cwd frameworks/react-router dev",
    "dev:patterns": "yarn --cwd patterns dev",
    "dev:templates": "yarn --cwd templates dev",
    "build": "yarn build:patterns && yarn build:react-router && yarn build:templates",
    "build:next-js": "yarn --cwd frameworks/next-js build",
    "build:react-router": "yarn --cwd frameworks/react-router build",
    "build:patterns": "yarn --cwd patterns build",
    "build:templates": "yarn --cwd templates build",
    "preview:next-js": "yarn --cwd frameworks/next-js start",
    "preview:react-router": "yarn --cwd frameworks/react-router start",
    "preview:patterns": "yarn --cwd patterns preview",
    "preview:templates": "yarn --cwd templates preview",
    "format": "biome format",
    "lint": "biome lint",
    "test:e2e:patterns": "yarn --cwd patterns test:e2e",
    "test:a11y:patterns": "yarn --cwd patterns test:a11y",
    "test:vrt:patterns": "yarn --cwd patterns test:vrt",
    "clean": "find . -name 'node_modules' -type d -prune -print -exec rm -rf '{}' \\;",
    "docker": "docker compose -f docker-compose.yml -p porsche-design-system-examples run --service-ports --rm repository yarn \"${@}\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.4"
  },
  "volta": {
    "node": "22.12.0",
    "yarn": "1.22.22"
  }
}
