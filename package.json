{
  "name": "@porsche-design-system/examples",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frameworks/*",
    "patterns",
    "templates"
  ],
  "scripts": {
    "dev:angular": "npm run start --workspace=@porsche-design-system/angular",
    "dev:astro": "npm run dev --workspace=@porsche-design-system/astro",
    "dev:next-js": "npm run dev --workspace=@porsche-design-system/next-js",
    "dev:react": "npm run dev --workspace=@porsche-design-system/react",
    "dev:react-router": "npm run dev --workspace=@porsche-design-system/react-router",
    "dev:vanilla-js": "npm run dev --workspace=@porsche-design-system/vanilla-js",
    "dev:vue": "npm run dev --workspace=@porsche-design-system/vue",
    "dev:patterns": "npm run dev --workspace=@porsche-design-system/patterns",
    "dev:templates": "npm run dev --workspace=@porsche-design-system/templates",
    "build": "npm run build --workspaces",
    "build:angular": "npm run build --workspace=@porsche-design-system/angular",
    "build:astro": "npm run build --workspace=@porsche-design-system/astro",
    "build:next-js": "npm run build --workspace=@porsche-design-system/next-js",
    "build:react": "npm run build --workspace=@porsche-design-system/react",
    "build:react-router": "npm run build --workspace=@porsche-design-system/react-router",
    "build:vanilla-js": "npm run build --workspace=@porsche-design-system/vanilla-js",
    "build:vue": "npm run build --workspace=@porsche-design-system/vue",
    "build:patterns": "npm run build --workspace=@porsche-design-system/patterns",
    "build:templates": "npm run build --workspace=@porsche-design-system/templates",
    "preview:angular": "npm run watch --workspace=@porsche-design-system/angular",
    "preview:astro": "npm run preview --workspace=@porsche-design-system/astro",
    "preview:next-js": "npm run start --workspace=@porsche-design-system/next-js",
    "preview:react": "npm run preview --workspace=@porsche-design-system/react",
    "preview:react-router": "npm run start --workspace=@porsche-design-system/react-router",
    "preview:vanilla-js": "npm run preview --workspace=@porsche-design-system/vanilla-js",
    "preview:vue": "npm run preview --workspace=@porsche-design-system/vue",
    "preview:patterns": "npm run preview --workspace=@porsche-design-system/patterns",
    "preview:templates": "npm run preview --workspace=@porsche-design-system/templates",
    "format": "biome format",
    "lint": "biome lint",
    "test:e2e:angular": "npm run test:e2e --workspace=@porsche-design-system/angular",
    "test:e2e:astro": "npm run test:e2e --workspace=@porsche-design-system/astro",
    "test:e2e:next-js": "npm run test:e2e --workspace=@porsche-design-system/next-js",
    "test:e2e:react": "npm run test:e2e --workspace=@porsche-design-system/react",
    "test:e2e:react-router": "npm run test:e2e --workspace=@porsche-design-system/react-router",
    "test:e2e:vanilla-js": "npm run test:e2e --workspace=@porsche-design-system/vanilla-js",
    "test:e2e:vue": "npm run test:e2e --workspace=@porsche-design-system/vue",
    "test:e2e:patterns": "npm run test:e2e --workspace=@porsche-design-system/patterns",
    "test:a11y:patterns": "npm run test:a11y --workspace=@porsche-design-system/patterns",
    "test:vrt:patterns": "npm run test:vrt --workspace=@porsche-design-system/patterns",
    "npm:outdated": "npm outdated --workspaces",
    "npm:upgrade": "npx npm-check-updates --workspaces -u && npm install",
    "npm:remove": "find . -name 'node_modules' -type d -prune -print -exec rm -rf '{}' \\;",
    "npm:clean": "npm cache clean --force"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "prettier": "^3.7.3"
  },
  "volta": {
    "node": "22.12.0"
  }
}
