{
  "$schema": "./node_modules/syncpack/schema.json",
  "sortFirst": [
    "name",
    "version",
    "private",
    "license",
    "scope",
    "repository",
    "bugs",
    "funding",
    "author",
    "homepage",
    "description",
    "keywords",
    "workspaces",
    "sideEffects",
    "type",
    "exports",
    "main",
    "module",
    "collection",
    "collection:main",
    "es2015",
    "es2017",
    "jsnext:main",
    "types",
    "browser",
    "style",
    "bin",
    "files",
    "engines",
    "packageManager",
    "scripts",
    "dependencies",
    "devDependencies",
    "peerDependencies",
    "peerDependenciesMeta",
    "optionalDependencies",
    "overrides",
    "volta"
  ],
  "sortAz": ["dependencies", "devDependencies", "peerDependencies"],
  "versionGroups": [
    {
      "label": "Porsche Design System components — keep every framework variant on the same version",
      "dependencies": [
        "@porsche-design-system/components-js",
        "@porsche-design-system/components-react",
        "@porsche-design-system/components-angular",
        "@porsche-design-system/components-vue"
      ],
      "policy": "sameRange"
    }
  ],
  "updateGroups": [
    {
      "label": "Held-back dependencies — upgraded deliberately, not via automated checks",
      "dependencies": ["@playwright/test"],
      "isIgnored": true
    }
  ]
}
